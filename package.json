{
  "name": "@offtrailstudio/transit-mapper",
  "version": "0.3.0",
  "description": "Embeddable GTFS-aligned schematic transit map editor (React + Mapbox).",
  "license": "MIT",
  "author": "Off-Trail Studio LLC",
  "homepage": "https://github.com/offtrailstudio/transit-mapper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offtrailstudio/transit-mapper.git"
  },
  "bugs": {
    "url": "https://github.com/offtrailstudio/transit-mapper/issues"
  },
  "keywords": [
    "transit",
    "map",
    "editor",
    "mapbox",
    "gtfs",
    "react",
    "schematic",
    "metro",
    "subway"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gtfs": {
      "types": "./dist/gtfs.d.ts",
      "import": "./dist/gtfs.js"
    }
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bunchee",
    "test": "vitest run",
    "build:catalog": "tsx scripts/build-catalog.ts"
  },
  "peerDependencies": {
    "csv-parse": ">=5",
    "fflate": ">=0.8",
    "mapbox-gl": ">=3",
    "react": ">=19",
    "react-dom": ">=19",
    "react-map-gl": ">=8"
  },
  "peerDependenciesMeta": {
    "csv-parse": {
      "optional": true
    },
    "fflate": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bunchee": "^7.0.1",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
